{
  "$schema": "https://schema.tauri.app/config/v2.json",
  "project": {
    "name": "frontend",
    "version": "0.1.0",
    "identifier": "com.frontend.app"
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "permissions": {
    "filesystem": {
      "scope": [
        "."
      ],
      "read": true,
      "write": true,
      "remove": true
    }
  },
  "windows": [
    {
      "title": "Frontend",
      "width": 800,
      "height": 600,
      "resizable": true
    }
  ],
  "security": {
    "csp": null
  }
}